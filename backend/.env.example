# ThirdEye Backend Environment Configuration
# Mandatory for AI features (will fall back to local heuristic engine if not provided)
GEMINI_API_KEY=

# Configurable Gemini Model Name (e.g. gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Server Port
PORT=5000

# Allowed CORS Frontend Origin
FRONTEND_ORIGIN=http://localhost:5173

# Optional Database URI (graceful fallback if omitted or disconnected)
MONGODB_URI=

# AI Fallback Enabled (true = transparently use heuristic engine on API issues)
AI_FALLBACK_ENABLED=true
